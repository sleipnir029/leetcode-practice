#!/usr/bin/env bash
# pre-commit hook — rebuild dashboard.html whenever progress.json is committed.
#
# The rebuild was a manual checklist step and got skipped twice, shipping a page that
# disagreed with the data. A stale dashboard doesn't fail loudly; it just quietly shows
# the wrong numbers, which is the one thing this repo can't afford.
#
# Only fires when progress.json is actually staged, so ordinary doc/code commits are untouched.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# No pipe into `grep -q` here, deliberately: grep exits on the first match, the upstream `git diff`
# dies of SIGPIPE (141), and under `pipefail` that makes a SUCCESSFUL match report failure — so the
# `|| exit 0` fired every time and the hook silently never rebuilt anything. Ask git directly.
staged=$(git diff --cached --name-only -- progress.json)
[ -n "$staged" ] || exit 0

python3 build_dashboard.py >/dev/null
git add dashboard.html
